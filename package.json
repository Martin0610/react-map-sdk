{
  "name": "react-map-sdk",
  "version": "1.0.1",
  "description": "A lightweight, reusable React Map SDK built with TypeScript, Leaflet, and OpenStreetMap.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/validation.test.ts && tsx test/geocoding.test.ts && tsx test/geolocation.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "map",
    "leaflet",
    "openstreetmap",
    "osm",
    "react-map",
    "gis",
    "typescript",
    "sdk"
  ],
  "author": "Martin0610",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Martin0610/react-map-sdk.git"
  },
  "homepage": "https://github.com/Martin0610/react-map-sdk#readme",
  "bugs": {
    "url": "https://github.com/Martin0610/react-map-sdk/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0 || >=17.0.0 || >=18.0.0 || >=19.0.0",
    "react-dom": ">=16.8.0 || >=17.0.0 || >=18.0.0 || >=19.0.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
